# =============================================================
# VARIABLES DE ENTORNO - SISTEMA DE RECONOCIMIENTO FACIAL
# =============================================================

# Entorno de ejecución: 'development', 'staging' o 'production'
ENVIRONMENT=development

# Secreto interno obligatorio compartido entre Backend y Supervisor de AI Workers
# ATENCIÓN: En 'production', el valor por defecto de desarrollo es rechazado en el arranque.
INTERNAL_API_SECRET=rf_secret_compartido_dev_mvp

# Modo local o Docker
# Para desarrollo local sin Redis activo, establece ENABLE_REDIS=false
ENABLE_REDIS=true

# Redis Broker & Queues
REDIS_URL=redis://localhost:6379/0
# Nota: En Docker Compose se usa internamente: redis://redis:6379/0
ALERTS_CHANNEL=alerts_channel
FACE_EVENTS_QUEUE=face_events_queue

# Base de datos (PostgreSQL o SQLite local de respaldo)
# Local: sqlite:///./reconocimiento.db
# Docker: postgresql://app_user:app_secure_password@postgres:5432/reconocimiento_facial
DATABASE_URL=sqlite:///./reconocimiento.db

# Almacenamiento MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=evidencias-rostros
S3_SECURE=false

# Motor de Búsqueda FAISS
FAISS_INDEX_PATH=search_service/faces.index
SIMILARITY_THRESHOLD=0.65

# Supervisor de AI Workers
# URL del backend donde el supervisor consulta las cámaras deseadas
BACKEND_URL=http://localhost:8000
# Intervalo en segundos entre ciclos de reconciliación
SUPERVISOR_POLL_INTERVAL=5.0
